#============ Docker Compose
# Image tag; deploy.sh sets it to the release tag
APP_VERSION=latest
# Host port where the app is published
APP_PORT=80
# MySQL data folder (relative to docker-compose.yml)
MYSQL_DATA_DIR=./mysql
TZ=America/Bogota

#============ App
# dev = TypeORM synchronizes the schema and /api/seed is enabled. Use prod on servers.
ENV=prod
# Inside Docker the app listens on 3000; `npm run dev` uses it too
PORT=3000

# Not root: the MySQL image refuses MYSQL_USER=root. DB_PASSWORD is also the root password.
DB_NAME=videlca_db
DB_USERNAME=videlca_user
DB_PASSWORD=change_me
# localhost for `npm run dev`; docker-compose overrides it with the db service
DB_HOST=localhost
DB_PORT=3306

# Public URLs (email links). Use the address people open, e.g. http://192.168.1.10
HOST_API=http://localhost:3000/api
HOST_PUBLIC=http://localhost:3000/
HOST_FRONTEND=http://localhost:5173

JWT_SECRET=change_me
AUTH_TOKEN=auth_token_cookie
TOKEN_VIDELCA=change_me
DEFAULT_LIMIT=10

#============ Email (gmail)
MAILER_SERVICE=gmail
MAILER_EMAIL=
MAILER_SECRET_KEY=
EMAIL_HOST_SERVICE=smtp.gmail.com

#============ Microsoft Graph
GRAPH_USERNAME=
GRAPH_PASSWORD=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SCOPE=https://graph.microsoft.com/.default
